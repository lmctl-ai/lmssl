# The chain is trusted but the name does not match: the handshake must fail on the host check.
# Run: lmssl --dsl fail-hostname.dslb PORT CAFILE
p = _lmcode_ schema="../schema/lmssl.dsl.json";
let conn = net.connect("127.0.0.1", str_to_int(ssl.args().at(0)));
let ctx = ssl.client_ctx();
ctx.ca_file(ssl.args().at(1));
let tls = ctx.connect(conn, "wrong.example");
out.line("handshake unexpectedly succeeded");
end _lmcode_
savedsl(p, ARGV[0]);
